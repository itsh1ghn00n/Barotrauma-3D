;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Barotrauma-3D"
run/main_scene="uid://81c6iyf2v1pj"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

CommandManager="*res://scripts/UI/command_manager.gd"
ItemAPI="*res://itemdata/item_api.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d-1.6.0/debug_draw_3d"

[dotnet]

project/assembly_name="New Game Project"

[editor]

run/main_run_args="--host"

[editor_plugins]

enabled=PackedStringArray("res://addons/raytraced_audio/plugin.cfg", "res://addons/verlet_rope_4/plugin.cfg")

[global_group]

Compartments=""
ballasts=""
radar_target=""
radar_scrap=""
radar_creature=""
radar_ruin=""

