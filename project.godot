[layer_names]

3d_render/layer_7="Sonar Terrain"
3d_physics/layer_3="Interactable"
3d_physics/layer_4="Scrappable"
3d_physics/layer_6="Layer 6"

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/atlas_16_bits=false
textures/default_filters/anisotropic_filtering_level=1
textures/default_filters/texture_mipmap_bias=-1.0
textures/decals/filter=0
textures/light_projectors/filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
mesh_lod/positional_shadow/atlas_quadrant_3_subdiv=6
mesh_lod/positional_shadow/atlas_quadrant_2_subdiv=5
mesh_lod/positional_shadow/atlas_quadrant_1_subdiv=4
mesh_lod/positional_shadow/atlas_quadrant_0_subdiv=3
mesh_lod/positional_shadow/atlas_size=8192
